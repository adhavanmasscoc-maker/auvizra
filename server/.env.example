# Vizora Server Environment Variables
PORT=5000

# Optional: Google Gemini API Key for deep LLM sliding context & question generation
# (If not provided, Vizora automatically uses its high-performance built-in semantic engine)
GEMINI_API_KEY=

# Optional: OpenAI Whisper API Key for server-side audio transcription
# (Browser-native Web Speech API is used by default with zero latency and zero cost)
OPENAI_API_KEY=
